{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/",
      "destination": "/events.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/proxy?target=/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "/api/proxy?target=/media/$1"
    }
  ],
  "trailingSlash": true
}
