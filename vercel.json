{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/",
      "destination": "/events.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?target=/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "/api/proxy?target=/media/:path*"
    }
  ]
}
